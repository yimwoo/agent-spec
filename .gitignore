# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local env
.venv/
venv/
.env
.codex/config.toml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# AgentSpec local cache + locks (per .agentspec/config.yml; storage_mode=committed
# applies to source documents, not the runtime cache).
.agentspec/cache/
.agentspec/locks/

# Generated runtime reports — regenerable via `agentspec doctor` /
# `agentspec compile` / `agentspec drift`. The .gitkeep markers stay so a fresh
# clone preserves the report directory layout.
reports/*/*
!reports/*/.gitkeep
# Dogfood notes (R-139) are durable artifacts; keep them tracked.
!reports/dogfood/*.md
# Latest quality grade is durable agent-facing state.
!reports/quality/latest.yml
!reports/quality/latest.md

# Supervised-run state. Raw events/state stay local, but ADR-0004 requires
# committed summary projections for autonomous-style runs.
agent/runs/*
!agent/runs/.gitkeep
!agent/runs/*/
agent/runs/*/*
!agent/runs/*/summary.yml
